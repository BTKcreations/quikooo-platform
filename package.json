{
  "name": "quikooo-platform",
  "version": "1.0.0",
  "private": true,
  "description": "QUIKOOO Hyperlocal Commerce & Delivery Monorepo",
  "workspaces": [
    "backend",
    "frontend/design-system",
    "apps/customer-web",
    "apps/merchant-studio",
    "apps/driver-fleet",
    "apps/agent-app"
  ],
  "scripts": {
    "test": "npm test --workspace=backend && npm test --workspace=@quikooo/design-system && npm test --workspace=customer-web && npm test --workspace=merchant-studio && npm test --workspace=driver-fleet && npm test --workspace=agent-app",
    "test:backend": "npm test --workspace=backend",
    "test:design": "npm test --workspace=@quikooo/design-system",
    "test:customer": "npm test --workspace=customer-web",
    "test:merchant": "npm test --workspace=merchant-studio",
    "test:driver": "npm test --workspace=driver-fleet",
    "test:agent": "npm test --workspace=agent-app",
    "build": "npm run build --workspace=customer-web && npm run build --workspace=merchant-studio && npm run build --workspace=driver-fleet && npm run build --workspace=agent-app",
    "build:customer": "npm run build --workspace=customer-web",
    "build:merchant": "npm run build --workspace=merchant-studio",
    "build:driver": "npm run build --workspace=driver-fleet",
    "build:agent": "npm run build --workspace=agent-app",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:customer": "npm run dev --workspace=customer-web",
    "dev:merchant": "npm run dev --workspace=merchant-studio",
    "dev:driver": "npm run dev --workspace=driver-fleet",
    "dev:agent": "npm run dev --workspace=agent-app"
  },
  "keywords": [
    "hyperlocal",
    "pwa",
    "ecommerce",
    "quikooo"
  ],
  "author": "QUIKOOO Team",
  "license": "ISC"
}
