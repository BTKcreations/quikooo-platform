# ============================================================================
# QUIKOOO Hyperlocal Commerce Platform - Backend Environment Variables
# Source of Truth: docs/11-DATABASE-AND-PRODUCTION.md
# ============================================================================

# 1. Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# 2. Database Connectivity (PostgreSQL 14+ with PostGIS)
# In production (Supabase/Neon/RDS), provide DATABASE_URL with sslmode
DATABASE_URL=postgresql://quikooo_user:quikooo_pass@localhost:5432/quikooo_db?sslmode=disable

# Fail-fast flag for production reliability:
# When REQUIRE_DB=true, backend will immediately exit (code 1) if Postgres is unreachable.
# When REQUIRE_DB=false, backend starts gracefully in offline/mock-ready development mode.
REQUIRE_DB=false

# Optional individual connection parameters if DATABASE_URL is not used:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quikooo_db
DB_USER=quikooo_user
DB_PASSWORD=quikooo_pass
DB_SSL=false
DB_MAX_CONNECTIONS=20

# 3. Authentication & Security
# Rotate in production using openssl rand -base64 48
JWT_SECRET=quikooo_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# 4. Official Hyperlocal Pricing & Revenue Model (Phase 1 Canonical)
# NOTE: DO NOT revert to deprecated 12% commission
RESTAURANT_MENU_ADJUSTMENT_PERCENT=5
RESTAURANT_PLATFORM_COMMISSION_PERCENT=10
CUSTOMER_PLATFORM_FEE=5.00
CUSTOMER_DELIVERY_FEE=25.00
DELIVERY_PARTNER_PAYOUT=25.00
AGENT_SHARE_PERCENT=60
QUIKOOO_SHARE_PERCENT=40

# 5. Geofence & Logistics Windows
DEFAULT_RADIUS_KM=2
RURAL_CUTOFF=21:00
RURAL_DELIVERY_WINDOW_START=05:00
RURAL_DELIVERY_WINDOW_END=08:00
TIMEZONE=Asia/Kolkata

# 6. Taxation & Statutory Deductions
TAX_RATE=0.18
