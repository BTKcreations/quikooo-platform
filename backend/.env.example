# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Authentication
JWT_SECRET=quikooo_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://quikooo_user:quikooo_pass@localhost:5432/quikooo_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quikooo_db
DB_USER=quikooo_user
DB_PASSWORD=quikooo_pass
DB_SSL=false
DB_MAX_CONNECTIONS=20

# Official Pricing & Revenue Model (Phase 1)
# DO NOT USE OLD 12% COMMISSION
RESTAURANT_MENU_ADJUSTMENT_PERCENT=5
RESTAURANT_PLATFORM_COMMISSION_PERCENT=10
CUSTOMER_PLATFORM_FEE=5
CUSTOMER_DELIVERY_FEE=25
DELIVERY_PARTNER_PAYOUT=25
AGENT_SHARE_PERCENT=60
QUIKOOO_SHARE_PERCENT=40

# Zone & Delivery Parameters
DEFAULT_RADIUS_KM=2
RURAL_CUTOFF=21:00
RURAL_DELIVERY_WINDOW_START=05:00
RURAL_DELIVERY_WINDOW_END=08:00
TIMEZONE=Asia/Kolkata

# Tax & Finance
TAX_RATE=0.18
